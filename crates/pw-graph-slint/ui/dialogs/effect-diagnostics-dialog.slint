import { TextEdit } from "std-widgets.slint";
import { UiTheme } from "../foundation/theme.slint";
import { ActionButton } from "../components/button.slint";
import { DialogShell } from "../components/dialog-shell.slint";

export component EffectDiagnosticsDialog inherits DialogShell {
    title: root.effect-name;
    in property <string> effect-name: "Effect diagnostics";
    in property <string> health: "";
    in property <string> report: "";
    callback copy-diagnostics();

    Text {
        x: 20px; y: 55px; width: parent.width - 40px; height: 22px;
        text: "Health: " + root.health;
        color: root.health == "FAILED" ? #ff7b7b : (root.health == "OVERLOADED" ? #ffc46b : #8bd5ca);
        font-size: 11px * UiTheme.panel-scale;
    }
    diagnostics := TextEdit {
        x: 20px; y: 84px; width: parent.width - 40px; height: parent.height - 143px;
        text: root.report;
        read-only: true;
        wrap: no-wrap;
        font-size: 10px * UiTheme.panel-scale;
    }
    ActionButton {
        x: 20px; y: parent.height - 48px; width: 145px;
        text: "Copy diagnostics";
        clicked => { diagnostics.select-all(); diagnostics.copy(); root.copy-diagnostics(); }
    }
    ActionButton {
        x: parent.width - 105px; y: parent.height - 48px; width: 85px;
        text: "Close";
        clicked => { root.close(); }
    }
}

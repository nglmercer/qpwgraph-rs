import { DiagnosticsDialog } from "../components/diagnostics-dialog.slint";

export component EffectDiagnosticsDialog inherits DiagnosticsDialog {
    title: root.effect-name;
    in property <string> effect-name: "Effect diagnostics";
    in property <string> health: "";
    summary: "Health: " + root.health;
    summary-color: root.health == "FAILED" ? #ff7b7b : (root.health == "OVERLOADED" ? #ffc46b : #8bd5ca);
}

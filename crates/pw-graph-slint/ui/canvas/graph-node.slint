import { NodeAudioControl, NodeMeter } from "../components/node-audio.slint";
import { UiTheme } from "../foundation/theme.slint";
import { UiI18n } from "../foundation/i18n.slint";
import { NodeRow } from "../foundation/structs.slint";

export component GraphNode inherits Rectangle {
    in property <NodeRow> data;
    in property <length> offset-x: 0px;
    in property <length> offset-y: 0px;
    callback audio-volume-changed(int, float);
    callback audio-mute-toggled(int);
    callback collapse-toggled(int);

    x: data.x * 1px + root.offset-x;
    y: data.y * 1px + root.offset-y;
    width: data.width * 1px;
    height: data.height * 1px;
    background: transparent;
    clip: false;
    accessible-role: list-item;
    accessible-label: data.node-title;
    accessible-description: data.selected ? UiI18n.localized("canvas.selected") : "";

    Rectangle {
        width: 100%;
        height: 100%;
        background: data.selected ? #293d58 : #242a31;
        border-color: data.selected ? #62a8ff : #536273;
        border-width: data.selected ? 2px : 1px;
        border-radius: 7px;
    }

    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: 40px;
        background: #354456; border-radius: 6px;
        Rectangle {
            x: 0px; y: 0px; width: 4px; height: parent.height;
            background: data.accent; border-radius: 4px;
        }
        if data.has-icon: Image {
            x: 9px; y: 9px; width: 20px; height: 20px;
            source: data.icon;
        }
        Text {
            x: data.has-icon ? 34px : 12px;
            y: 3px; width: parent.width - (data.has-icon ? 74px : 52px); height: 20px;
            text: data.node-title; color: #f5f8fa;
            font-size: 12px * data.font-scale * UiTheme.node-scale;
            vertical-alignment: center; overflow: elide;
        }
        Text {
            x: data.has-icon ? 34px : 12px;
            y: 21px; width: parent.width - (data.has-icon ? 74px : 52px); height: 21px;
            text: data.node-subtitle; color: #d4dde5;
            font-size: 8px * data.font-scale * UiTheme.node-scale;
            vertical-alignment: center; overflow: elide;
        }
        if !data.thumbnail: Rectangle {
            x: parent.width - 27px; y: 12px; width: 15px; height: 15px;
            border-color: #dbe6ed80; border-width: 1px; border-radius: 7px;
            Text {
                width: parent.width; height: parent.height;
                text: data.collapsed ? "+" : "−"; color: #eef4f8;
                font-size: 11px * UiTheme.node-scale;
                horizontal-alignment: center; vertical-alignment: center;
            }
            TouchArea {
                width: 100%; height: 100%;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.collapse-toggled(data.id); }
            }
        }
    }

    if !data.collapsed && !data.thumbnail && data.has-audio-panel: Rectangle {
        x: 1px; y: 41px; width: parent.width - 2px; height: parent.height - 42px;
        background: transparent; clip: false;
        if data.has-audio-controls: NodeAudioControl {
            x: 10px; y: 7px; width: parent.width - 20px;
            volume-position: data.audio-volume-position;
            volume-known: data.audio-volume-known;
            muted: data.audio-muted;
            volume-enabled: data.audio-volume-enabled;
            mute-enabled: data.audio-mute-enabled;
            meter-peak: data.meter-peak;
            meter-peak-position: data.meter-peak-position;
            meter-rms: data.meter-rms;
            meter-rms-position: data.meter-rms-position;
            meter-peak-supported: data.meter-peak-supported;
            meter-rms-supported: data.meter-rms-supported;
            meter-label: data.meter-label;
            meter-available: data.meter-available;
            mute-known: data.audio-mute-known;
            accent: data.accent;
            volume-changed(value) => { root.audio-volume-changed(data.id, value); }
            mute-toggled => { root.audio-mute-toggled(data.id); }
        }
        if !data.has-audio-controls && data.has-meter: NodeMeter {
            x: 10px; y: 7px; width: parent.width - 20px;
            rms: data.meter-rms; peak: data.meter-peak;
            rms-position: data.meter-rms-position; peak-position: data.meter-peak-position;
            peak-supported: data.meter-peak-supported; rms-supported: data.meter-rms-supported;
            available: data.meter-available; label: data.meter-label; accent: data.accent;
        }
    }

    if !data.collapsed && !data.thumbnail: Rectangle {
        width: 100%; height: 100%; background: transparent; clip: false;
        for port in data.ports: Rectangle {
            x: 13px; y: port.row-y * 1px; width: parent.width - 26px; height: 22px;
            background: transparent;
            Text {
                x: port.direction == 0 ? 8px : 0px;
                width: parent.width - 8px; height: parent.height;
                text: port.label; color: #d8e0e7;
                font-size: 10px * data.font-scale * UiTheme.node-scale;
                horizontal-alignment: port.direction == 0 ? left : right;
                vertical-alignment: center; overflow: elide;
            }
        }
        for port in data.ports: Rectangle {
            x: (port.pin-x - 5.5) * 1px;
            y: (port.pin-y - 5.5) * 1px;
            width: 11px; height: 11px; border-radius: 5.5px;
            background: port.color; border-color: #10151b; border-width: 1px;
        }
    }
}

import { LineEdit, ScrollView, VerticalBox } from "std-widgets.slint";
import {
    HitResult,
    LinkRow,
    MinimapNode,
    NodeCanvas,
    NodeRow,
    PortRow,
} from "node-canvas.slint";
import {
    PreferencesDialog,
    RuleRow,
    ShortcutsDialog,
    ShortcutRow,
    UiTheme,
    UiI18n,
} from "parity-components.slint";
import { RailActionButton } from "components/navigation-rail.slint";
import { RailTooltip, ConnectionToast } from "components/toast.slint";
import { ActionButton } from "components/button.slint";
import { HistoryDialog } from "dialogs/history-dialog.slint";
import { EffectsDialog } from "dialogs/effects-dialog.slint";
import { QrDialog } from "dialogs/qr-dialog.slint";
import { RelayPanel } from "panels/relay-panel.slint";
import { NodeAppearancePanel } from "panels/node-appearance-panel.slint";
import { DialogShell } from "components/dialog-shell.slint";
import { ActionButton } from "components/button.slint";
import { EffectParameterRow, EffectRow, RelayRow, HistoryRow } from "foundation/structs.slint";

export { HitResult, LinkRow, MinimapNode, NodeRow, PortRow, UiI18n, UiTheme, EffectParameterRow, EffectRow, RelayRow, HistoryRow }

export component MainWindow inherits Window {
    title: UiI18n.localized("app.title");
    icon: @image-url("../../../assets/icons/brand.svg");
    background: #191d24;
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 760px;
    min-height: 520px;

    in property <[NodeRow]> nodes: [];
    in property <[LinkRow]> links: [];
    in property <[MinimapNode]> minimap-nodes: [];
    in property <[RuleRow]> rules: [];
    in property <[ShortcutRow]> shortcuts: [];
    in property <[HistoryRow]> undo-history: [];
    in property <[HistoryRow]> redo-history: [];
    in property <[EffectRow]> effects: [];
    in property <[string]> effect-options: [];
    in property <bool> effects-available: false;
    in property <[RelayRow]> relay-rows: [];
    in property <[EffectParameterRow]> effect-setup-parameters: [];
    in-out property <bool> effect-configuring: false;
    in-out property <bool> effect-setup-enabled: true;
    in property <string> status: UiI18n.localized("status.starting");
    in property <string> toast-message: "";
    in property <bool> toast-visible: false;
    in property <bool> toast-error: false;
    in property <string> backend: "";
    in property <string> graph-counts: "";
    in property <bool> has-selected-link: false;
    in property <bool> has-selected-node: false;
    in-out property <bool> show-statusbar: true;
    in-out property <bool> show-common-actions: true;
    in-out property <bool> show-patchbay-toolbar: true;
    in-out property <bool> repel-overlaps: true;
    in-out property <bool> connect-through: false;
    in-out property <bool> thumbnail-view: false;
    in-out property <int> language-index: 0;
    in-out property <int> meter-policy-index: 1;
    in-out property <float> ui-text-scale: 1.1;
    in-out property <float> panel-text-scale: 1.2;
    in-out property <float> node-text-scale: 1.15;
    in-out property <bool> patchbay-exclusive: false;
    in-out property <bool> patchbay-auto-disconnect: false;
    in-out property <bool> patchbay-auto-pin: false;
    in-out property <bool> patchbay-activated: false;
    in-out property <string> profile-name: "";
    in-out property <string> shortcut-search: "";
    in property <string> config-path: "";
    in property <string> patchbay-path: "";
    in property <[string]> profile-options: [];
    in property <[string]> recent-patchbay-paths: [];
    in-out property <int> profile-index: 0;
    in-out property <bool> show-minimap: false;
    in-out property <string> sort-type: "name";
    in-out property <string> sort-order: "ascending";
    in-out property <bool> show-preferences: false;
    in-out property <bool> show-history: false;
    in-out property <bool> show-shortcuts: false;
    in-out property <bool> show-effects: false;
    in-out property <bool> show-node-editor: false;
    in-out property <bool> show-relay: false;
    in-out property <bool> show-qr: false;
    // --- Keyboard policy -------------------------------------------------
    // The three questions every key handler needs to ask, answered once here
    // instead of being re-derived at each call site. `docs/keyboard.md` and
    // `src/shortcuts.rs` describe the contract these express.
    //
    // A modal owns the keyboard: while one is up the graph shortcuts behind it
    // stay inert. The relay panel is deliberately absent — it is a side panel,
    // not a modal, so the canvas keymap survives it and only its own text
    // fields suppress typing shortcuts.
    out property <bool> modal-open: root.show-preferences || root.show-history
        || root.show-shortcuts || root.show-effects || root.show-node-editor
        || root.show-qr || root.relay-pending-active;
    // Text editing always wins: a typed 'r', 'a' or digit belongs to the field.
    out property <bool> text-editing: TextInputInterface.text-input-focused;
    out property <bool> canvas-shortcuts-enabled: !root.modal-open && !root.text-editing;
    in-out property <int> preferences-tab: 0;
    in-out property <int> relay-tab: 0;
    in-out property <string> relay-device-name: "";
    in-out property <string> relay-host-pin: "";
    in-out property <string> relay-host-port-text: "48123";
    in-out property <string> relay-client-target: "";
    in-out property <string> relay-client-pin: "";
    in-out property <bool> relay-auto-connect-trusted: true;
    in-out property <int> relay-codec-index: 0;
    in-out property <int> relay-frame-index: 0;
    in-out property <int> relay-transport-index: 0;
    in property <[string]> relay-codec-options: [];
    in property <[string]> relay-frame-options: [];
    in property <[string]> relay-transport-options: [];
    in property <[string]> relay-send-source-options: [];
    in property <[string]> relay-receive-sink-options: [];
    in-out property <int> relay-send-source-index: 0;
    in-out property <int> relay-receive-sink-index: 0;
    in-out property <int> effect-selection-index: 0;
    in property <bool> relay-available: false;
    in property <bool> relay-host-active: false;
    in property <string> relay-host-endpoint: "";
    in property <bool> relay-is-connecting: false;
    in property <bool> relay-direction-switching: false;
    in property <string> relay-qr-payload: "";
    in property <image> relay-qr-image;
    in property <bool> relay-pending-active: false;
    in property <string> relay-pending-peer-name: "";
    in property <string> relay-pending-peer-addr: "";
    in property <string> relay-pending-peer-id: "";
    in-out property <string> search-text: "";
    in-out property <int> rule-editor-index: -1;
    in-out property <string> rule-output-node: "";
    in-out property <string> rule-output-port: "";
    in-out property <string> rule-input-node: "";
    in-out property <string> rule-input-port: "";
    in-out property <string> node-editor-node-name: "";
    in-out property <string> node-editor-custom-name: "";
    in-out property <string> node-editor-color: "";
    in-out property <string> media-filter: "all";
    in-out property <string> connect-mode: "advanced";
    in property <bool> connections-available: true;
    in-out property <length> pan-x: 24px;
    in-out property <length> pan-y: 24px;
    in-out property <float> zoom: 1.0;
    in-out property <string> grid-commands: "";
    // Bumped by the bridge whenever the cached canvas geometry changes, so the
    // rendered edges are recomputed from the fresh node positions.
    in property <int> geometry-version: 0;
    in property <float> graph-min-x: 0;
    in property <float> graph-min-y: 0;
    in property <float> graph-max-x: 1600;
    in property <float> graph-max-y: 1200;
    out property <float> width_: self.width / 1px;
    out property <float> height_: self.height / 1px;
    out property <float> canvas-width_: canvas.width / 1px;
    out property <float> canvas-height_: canvas.height / 1px;
    out property <bool> graph-node-dragging: canvas.interacting;
    property <length> rail-width: 76px;
    // Shared rail-tooltip state, written by whichever button reports hover.
    property <string> tip-text;
    property <length> tip-anchor-y;
    property <bool> tip-shown: false;

    // A pointer moving straight from one button to the next can deliver the
    // new button's enter before the old one's leave, so a leave only hides
    // the tooltip when it comes from the button currently being shown.
    function rail-hover(entered: bool, label: string, anchor: length) {
        if (entered) {
            root.tip-text = label;
            root.tip-anchor-y = anchor;
            root.tip-shown = true;
        } else if (root.tip-text == label) {
            root.tip-shown = false;
        }
    }
    property <length> status-height: root.show-statusbar ? 34px * root.ui-text-scale : 0px;

    callback action(string);
    callback graph-node-selected(int, bool);
    callback graph-link-selected(int, bool);
    callback graph-selection-cleared();
    callback graph-box-selected(float, float, float, float, bool);
    callback graph-node-dragged(int, float, float);
    callback graph-link-requested(int, int);
    callback graph-link-dropped(int, float, float);
    callback graph-link-cancelled();
    callback graph-node-connect-dropped(int, float, float);
    callback graph-audio-volume-changed(int, float);
    callback graph-audio-mute-toggled(int);
    callback graph-node-collapse-toggled(int);
    // Geometry lives in Rust; these are the only questions the canvas asks.
    pure callback graph-hit-test(/* world-x */ float, /* world-y */ float, /* zoom */ float) -> HitResult;
    callback graph-link-rerouted(/* link-id */ int, /* new-pin */ int);
    pure callback graph-link-drag-anchor(/* link-id */ int, /* world-x */ float, /* world-y */ float) -> int;
    pure callback graph-pin-connectable(/* pin-id */ int) -> bool;
    pure callback graph-link-path(int, int, float, float) -> string;
    pure callback graph-pin-preview-path(int, float, float) -> string;
    pure callback graph-node-preview-path(int, float, float) -> string;
    callback graph-request-grid();

    changed show-preferences => { if (!root.show-preferences) { app_focus.focus(); } }
    changed show-history => { if (!root.show-history) { app_focus.focus(); } }
    changed show-shortcuts => {
        if (root.show-shortcuts) {
            workspace.focus-shortcut-search();
        } else {
            app_focus.focus();
        }
    }
    changed show-effects => { if (!root.show-effects) { app_focus.focus(); } }

    // One FocusScope for the whole window – rail, workspace, dialogs and the
    // status bar are all inside it. Slint delivers a key event to the focused
    // element and then bubbles it up the *parent* chain, never sideways: a
    // scope that wrapped only the canvas stopped receiving keys the moment a
    // LineEdit was clicked. As the common ancestor this one still sees every
    // key a focused text field or dialog rejects.
    app_focus := FocusScope {
        width: 100%;
        height: 100%;

        startup-focus := Timer {
            interval: 1ms;
            running: true;
            triggered => {
                self.running = false;
                app_focus.focus();
            }
        }
        // The canvas has no focus of its own: this scope owns the keymap,
        // so the shortcuts work on startup and again after a graph click.
        init => { app_focus.focus(); }
        key-pressed(event) => {
            // `control` is Slint's portable shortcut modifier: Ctrl on
            // Windows/Linux, Command on macOS. `meta` is the Windows key
            // (physical Control on macOS) and must never stand in for it,
            // or Win+Arrow would pan the graph instead of snapping windows.
            // Alt is excluded everywhere so Alt+R and friends stay free.
            let alt = event.modifiers.alt;
            let meta = event.modifiers.meta;
            let shift = event.modifiers.shift;
            let ctrl = event.modifiers.control && !alt && !meta;
            let ctrl-only = ctrl && !shift;
            let ctrl-shift = ctrl && shift;
            let bare = !event.modifiers.control && !alt && !meta;
            let plain = bare && !shift;

            // Application-global: these must work from inside a dialog and
            // from a focused text field, which is why they come first.
            if (event.text == Key.F1 && plain) {
                if (!event.repeat) { root.action("shortcuts"); }
                return accept;
            }
            if (event.text == Key.Escape && plain) {
                if (!event.repeat) {
                    canvas.cancel-gesture();
                    root.action("escape");
                }
                return accept;
            }
            if (ctrl-only && (event.text == "f" || event.text == "F") && root.show-shortcuts) {
                if (!event.repeat) { workspace.focus-shortcut-search(); }
                return accept;
            }

            // Everything below drives the graph behind the dialogs. One
            // property decides whether that layer may be reached at all.
            if (!root.canvas-shortcuts-enabled) { return reject; }

            // Panning and zooming are the only commands that want auto-repeat.
            if (event.text == Key.LeftArrow && (bare || ctrl-only)) { root.pan-x -= ctrl-only ? 192px : shift ? 96px : 48px; return accept; }
            if (event.text == Key.RightArrow && (bare || ctrl-only)) { root.pan-x += ctrl-only ? 192px : shift ? 96px : 48px; return accept; }
            if (event.text == Key.UpArrow && (bare || ctrl-only)) { root.pan-y -= ctrl-only ? 192px : shift ? 96px : 48px; return accept; }
            if (event.text == Key.DownArrow && (bare || ctrl-only)) { root.pan-y += ctrl-only ? 192px : shift ? 96px : 48px; return accept; }
            if (bare && (event.text == "+" || event.text == "=")) { root.action("zoom-in"); return accept; }
            if (bare && (event.text == "-" || event.text == "_")) { root.action("zoom-out"); return accept; }

            // Held keys stop here: a repeating 'T' or Ctrl+S would toggle the
            // thumbnail view or rewrite the configuration dozens of times.
            if (event.repeat) { return reject; }
            if (ctrl-shift && (event.text == "z" || event.text == "Z")) { root.action("redo"); return accept; }
            if (ctrl-only && (event.text == "z" || event.text == "Z")) { root.action("undo"); return accept; }
            if (ctrl-only && (event.text == "y" || event.text == "Y")) { root.action("redo"); return accept; }
            if (ctrl-shift && (event.text == "s" || event.text == "S")) { root.action("save-patchbay"); return accept; }
            if (ctrl-only && (event.text == "s" || event.text == "S")) { root.action("save-config"); return accept; }
            if (ctrl-only && (event.text == "o" || event.text == "O")) { root.action("load-patchbay"); return accept; }
            if (!bare) { return reject; }
            if (event.text == Key.Delete || event.text == Key.Backspace) { root.action("delete-selection"); return accept; }
            if (event.text == "r" || event.text == "R") { root.action("refresh"); return accept; }
            if (event.text == "a" || event.text == "A") { root.action("arrange"); return accept; }
            if (event.text == "t" || event.text == "T") { root.action("toggle-thumbnail"); return accept; }
            if (event.text == "0") { root.action("filter-all"); return accept; }
            if (event.text == "1") { root.action("filter-audio"); return accept; }
            if (event.text == "2") { root.action("filter-video"); return accept; }
            if (event.text == "3") { root.action("filter-midi"); return accept; }
            return reject;
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: root.rail-width;
            height: root.height - root.status-height;
            background: #20262d;
            Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: #36414c; }
            Image { x: 22px; y: 14px; width: 32px; height: 32px; source: @image-url("../../../assets/icons/brand.svg"); }

            rail-scroll := ScrollView {
                x: 0px;
                y: 54px;
                width: parent.width;
                height: max(1px, parent.height - 54px);
                VerticalBox {
                    x: 17px;
                    width: 42px;
                    spacing: 6px;

                    Rectangle { width: 42px; height: 2px; background: transparent; }
                    preferences_button := RailActionButton {
                        icon: @image-url("../../../assets/icons/settings.svg");
                        label: UiI18n.localized("nav.preferences"); active: root.show-preferences;
                        clicked => { root.action("preferences"); }
                        hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); }
                    }
                    appearance_button := RailActionButton {
                        icon: @image-url("../../../assets/icons/appearance.svg");
                        label: UiI18n.localized("inspector.node_appearance"); active: root.show-node-editor;
                        clicked => { root.action("node-appearance"); }
                        hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); }
                    }
                    relay_button := RailActionButton {
                        icon: @image-url("../../../assets/icons/relay.svg");
                        label: UiI18n.localized("nav.relay"); active: root.show-relay;
                        clicked => { root.action("relay"); }
                        hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); }
                    }
                    shortcuts_button := RailActionButton {
                        icon: @image-url("../../../assets/icons/help.svg");
                        label: UiI18n.localized("nav.shortcuts"); active: root.show-shortcuts;
                        clicked => { root.action("shortcuts"); }
                        hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); }
                    }
                    diagnostics_button := RailActionButton {
                        icon: @image-url("../../../assets/icons/diagnostics.svg");
                        label: UiI18n.localized("nav.diagnostics");
                        clicked => { root.action("copy-windows-audio-report"); }
                        hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); }
                    }

                    Rectangle { width: 52px; x: -5px; height: 1px; background: #35414d; }
                    Rectangle { width: 42px; height: 7px; background: transparent; }
                    minimap_button := RailActionButton { icon: @image-url("../../../assets/icons/minimap.svg"); label: UiI18n.localized("toolbar.minimap"); active: root.show-minimap; clicked => { root.action("toggle-minimap"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions : RailActionButton { icon: @image-url("../../../assets/icons/refresh.svg"); label: UiI18n.localized("toolbar.refresh"); clicked => { root.action("refresh"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions : RailActionButton { icon: @image-url("../../../assets/icons/undo.svg"); label: UiI18n.localized("toolbar.undo"); clicked => { root.action("undo"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions : RailActionButton { icon: @image-url("../../../assets/icons/redo.svg"); label: UiI18n.localized("toolbar.redo"); clicked => { root.action("redo"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions : RailActionButton { icon: @image-url("../../../assets/icons/timer.svg"); label: UiI18n.localized("toolbar.history"); active: root.show-history; clicked => { root.action("history"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions : RailActionButton { enabled: root.connections-available; icon: @image-url("../../../assets/icons/connect.svg"); label: root.connect-mode == "easy" ? UiI18n.localized("toolbar.connect_mode_easy") : UiI18n.localized("toolbar.connect_mode_advanced"); active: root.connect-mode == "easy"; clicked => { root.action("toggle-connect-mode"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions : RailActionButton { icon: @image-url("../../../assets/icons/repel.svg"); label: UiI18n.localized("inspector.arrange_nodes"); clicked => { root.action("arrange"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions : RailActionButton { icon: @image-url("../../../assets/icons/sort.svg"); label: root.sort-type == "name" ? UiI18n.localized("sort.name") : UiI18n.localized("sort.id"); active: root.sort-type == "name"; clicked => { root.action("toggle-sort-type"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions : RailActionButton { icon: @image-url("../../../assets/icons/sort_direction.svg"); label: root.sort-order == "ascending" ? UiI18n.localized("sort.ascending") : UiI18n.localized("sort.descending"); active: root.sort-order == "ascending"; clicked => { root.action("toggle-sort-order"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions && root.has-selected-link : RailActionButton { enabled: root.connections-available; icon: @image-url("../../../assets/icons/disconnect_link.svg"); label: UiI18n.localized("toolbar.disconnect"); clicked => { root.action("delete-selection"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions && root.links.length > 0 : RailActionButton { enabled: root.connections-available; icon: @image-url("../../../assets/icons/disconnect_all.svg"); label: UiI18n.localized("toolbar.disconnect_all"); clicked => { root.action("disconnect-all"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions && root.has-selected-node : RailActionButton { enabled: root.connections-available; icon: @image-url("../../../assets/icons/disconnect_node.svg"); label: UiI18n.localized("canvas.disconnect_node"); clicked => { root.action("disconnect-node"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions : RailActionButton { icon: @image-url("../../../assets/icons/effects.svg"); label: UiI18n.localized("effects.title"); active: root.show-effects; clicked => { root.action("effects"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-patchbay-toolbar : RailActionButton { icon: @image-url("../../../assets/icons/save.svg"); label: UiI18n.localized("toolbar.save_patchbay"); clicked => { root.action("save-patchbay"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-patchbay-toolbar : RailActionButton { icon: @image-url("../../../assets/icons/load.svg"); label: UiI18n.localized("toolbar.load_patchbay"); clicked => { root.action("load-patchbay"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-patchbay-toolbar : RailActionButton { icon: @image-url("../../../assets/icons/snapshot.svg"); label: UiI18n.localized("toolbar.snapshot"); clicked => { root.action("snapshot-patchbay"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-patchbay-toolbar : RailActionButton { icon: @image-url("../../../assets/icons/activate.svg"); label: UiI18n.localized("toolbar.activate"); active: root.patchbay-activated; clicked => { root.action("activate-patchbay"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }
                    if root.show-common-actions : RailActionButton { icon: @image-url("../../../assets/icons/filter.svg"); label: UiI18n.localized("toolbar.media_filter"); active: root.media-filter != "all"; clicked => { root.action("cycle-filter"); } hover-changed(entered, label, anchor) => { root.rail-hover(entered, label, anchor); } }

                    Rectangle {
                        width: 42px;
                        height: 29px;
                        background: #182029;
                        border-color: #394653;
                        border-width: 1px;
                        border-radius: 4px;
                        Text { width: parent.width; height: parent.height; text: root.media-filter == "audio" ? "1" : root.media-filter == "video" ? "2" : root.media-filter == "midi" ? "3" : "0"; color: #a9b7c3; horizontal-alignment: center; vertical-alignment: center; font-size: 11px * UiTheme.ui-scale; }
                    }
                }
            }
        }

        workspace := Rectangle {
            x: root.rail-width;
            y: 0px;
            width: root.width - root.rail-width;
            height: root.height - root.status-height;
            background: #191d24;
            // The Relay panel is an overlay: it covers the right half of the
            // workspace instead of taking width away from the canvas, so opening
            // it never moves, resizes or reflows the node graph.
            property <length> relay-sidebar-width: root.show-relay ? self.width / 2 : 0px;

            public function focus-shortcut-search() {
                shortcut-dialog.focus-search();
            }

            canvas := NodeCanvas {
                width: parent.width;
                height: parent.height;
                pan-x <=> root.pan-x;
                pan-y <=> root.pan-y;
                zoom <=> root.zoom;
                nodes: root.nodes;
                links: root.links;
                minimap-enabled: root.show-minimap;
                minimap-nodes: root.minimap-nodes;
                easy-connect: root.connect-mode == "easy";
                connect-through: root.connect-through;
                connections-enabled: root.connections-available;
                geometry-version: root.geometry-version;
                grid-commands: root.grid-commands;
                graph-min-x: root.graph-min-x;
                graph-min-y: root.graph-min-y;
                graph-max-x: root.graph-max-x;
                graph-max-y: root.graph-max-y;
                min-zoom: 0.35;
                max-zoom: 2.5;

                hit-test(x, y, zoom) => { root.graph-hit-test(x, y, zoom) }
                link-rerouted(link, pin) => { root.graph-link-rerouted(link, pin); }
                link-drag-anchor(link, x, y) => { root.graph-link-drag-anchor(link, x, y) }
                pin-connectable(pin) => { root.graph-pin-connectable(pin) }
                link-path(id, version, dx, dy) => { root.graph-link-path(id, version, dx, dy) }
                pin-preview-path(pin, x, y) => { root.graph-pin-preview-path(pin, x, y) }
                node-preview-path(node, x, y) => { root.graph-node-preview-path(node, x, y) }
                request-grid => { root.graph-request-grid(); }
                focus-requested => { app_focus.focus(); }

                node-selected(id, shift) => { root.graph-node-selected(id, shift); }
                link-selected(id, shift) => { root.graph-link-selected(id, shift); }
                selection-cleared => { root.graph-selection-cleared(); }
                box-selected(x, y, w, h, shift) => { root.graph-box-selected(x, y, w, h, shift); }
                drag-committed(id, dx, dy) => { root.graph-node-dragged(id, dx, dy); }
                link-requested(start, end) => { root.graph-link-requested(start, end); }
                link-dropped(start, x, y) => { root.graph-link-dropped(start, x, y); }
                link-cancelled => { root.graph-link-cancelled(); }
                node-connect-dropped(id, x, y) => { root.graph-node-connect-dropped(id, x, y); }
                node-double-clicked(id) => { root.graph-node-collapse-toggled(id); }
                audio-volume-changed(id, value) => { root.graph-audio-volume-changed(id, value); }
                audio-mute-toggled(id) => { root.graph-audio-mute-toggled(id); }
                collapse-toggled(id) => { root.graph-node-collapse-toggled(id); }
            }

            LineEdit {
                x: 16px;
                y: 12px;
                width: max(0px, min(280px, parent.width - workspace.relay-sidebar-width - 32px));
                height: 30px;
                placeholder-text: UiI18n.localized("search.placeholder");
                text <=> root.search-text;
                z: 1;
            }

            if root.show-relay: RelayPanel {
                x: parent.width - workspace.relay-sidebar-width;
                y: 0px;
                width: workspace.relay-sidebar-width;
                height: parent.height;
                // Above the canvas and the search field it overlaps.
                z: 2;
                relay-tab <=> root.relay-tab;
                relay-rows: root.relay-rows;
                relay-device-name <=> root.relay-device-name;
                relay-host-pin <=> root.relay-host-pin;
                relay-host-port-text <=> root.relay-host-port-text;
                relay-client-target <=> root.relay-client-target;
                relay-client-pin <=> root.relay-client-pin;
                relay-auto-connect-trusted <=> root.relay-auto-connect-trusted;
                relay-codec-index <=> root.relay-codec-index;
                relay-frame-index <=> root.relay-frame-index;
                relay-transport-index <=> root.relay-transport-index;
                relay-codec-options: root.relay-codec-options;
                relay-frame-options: root.relay-frame-options;
                relay-transport-options: root.relay-transport-options;
                relay-send-source-options: root.relay-send-source-options;
                relay-receive-sink-options: root.relay-receive-sink-options;
                relay-send-source-index <=> root.relay-send-source-index;
                relay-receive-sink-index <=> root.relay-receive-sink-index;
                relay-available: root.relay-available;
                relay-host-active: root.relay-host-active;
                relay-host-endpoint: root.relay-host-endpoint;
                relay-qr-payload: root.relay-qr-payload;
                relay-is-connecting: root.relay-is-connecting;
                relay-direction-switching: root.relay-direction-switching;
                action(action) => { root.action(action); }
                close => { root.action("relay"); }
            }

            if root.show-preferences: Rectangle {
                width: parent.width; height: parent.height; background: #05070a99;
                PreferencesDialog {
                    x: max(16px, (parent.width - min(930px, parent.width - 32px)) / 2);
                    y: max(16px, (parent.height - min(700px, parent.height - 32px)) / 2);
                    width: min(930px, parent.width - 32px);
                    height: min(700px, parent.height - 32px);
                    tab <=> root.preferences-tab;
                    language-index <=> root.language-index;
                    show-common-actions <=> root.show-common-actions;
                    show-statusbar <=> root.show-statusbar;
                    show-patchbay-toolbar <=> root.show-patchbay-toolbar;
                    repel-overlaps <=> root.repel-overlaps;
                    connect-through <=> root.connect-through;
                    thumbnail-view <=> root.thumbnail-view;
                    meter-policy-index <=> root.meter-policy-index;
                    ui-scale <=> root.ui-text-scale;
                    panel-scale <=> root.panel-text-scale;
                    node-scale <=> root.node-text-scale;
                    patchbay-exclusive <=> root.patchbay-exclusive;
                    patchbay-auto-disconnect <=> root.patchbay-auto-disconnect;
                    patchbay-auto-pin <=> root.patchbay-auto-pin;
                    patchbay-activated <=> root.patchbay-activated;
                    profile-name <=> root.profile-name;
                    profile-options: root.profile-options;
                    profile-index <=> root.profile-index;
                    recent-patchbay-paths: root.recent-patchbay-paths;
                    config-path: root.config-path;
                    patchbay-path: root.patchbay-path;
                    rules: root.rules;
                    rule-editor-index <=> root.rule-editor-index;
                    rule-output-node <=> root.rule-output-node;
                    rule-output-port <=> root.rule-output-port;
                    rule-input-node <=> root.rule-input-node;
                    rule-input-port <=> root.rule-input-port;
                    close => { root.action("preferences"); }
                    action(action) => { root.action(action); }
                }
            }

            if root.show-node-editor: NodeAppearancePanel {
                x: max(24px, (parent.width - 470px) / 2);
                y: max(34px, (parent.height - 300px) / 2);
                width: min(470px, parent.width - 48px);
                height: 300px;
                z: 50;
                node-editor-node-name <=> root.node-editor-node-name;
                node-editor-custom-name <=> root.node-editor-custom-name;
                node-editor-color <=> root.node-editor-color;
                action(action) => { root.action(action); }
            }

            if root.show-history: HistoryDialog {
                x: max(24px, (parent.width - 560px) / 2); y: max(32px, (parent.height - 350px) / 2); width: min(560px, parent.width - 48px); height: min(350px, parent.height - 64px);
                undo-history: root.undo-history;
                redo-history: root.redo-history;
                close => { root.action("history"); }
            }

            shortcut-overlay := Rectangle {
                visible: root.show-shortcuts;
                width: parent.width; height: parent.height; background: #05070a99;
            }
            shortcut-dialog := ShortcutsDialog {
                visible: root.show-shortcuts;
                x: max(16px, (parent.width - min(650px, parent.width - 32px)) / 2);
                y: max(16px, (parent.height - min(590px, parent.height - 32px)) / 2);
                width: min(650px, parent.width - 32px);
                height: min(590px, parent.height - 32px);
                entries: root.shortcuts;
                search-text <=> root.shortcut-search;
                close => { root.action("shortcuts"); }
            }

            if root.show-effects: EffectsDialog {
                x: max(24px, (parent.width - 700px) / 2); y: max(28px, (parent.height - 510px) / 2); width: min(700px, parent.width - 48px); height: min(510px, parent.height - 56px);
                effects: root.effects;
                effect-options: root.effect-options;
                effects-available: root.effects-available;
                effect-setup-parameters: root.effect-setup-parameters;
                effect-configuring <=> root.effect-configuring;
                effect-setup-enabled <=> root.effect-setup-enabled;
                effect-selection-index <=> root.effect-selection-index;
                action(action) => { root.action(action); }
                close => { root.action("effects"); }
            }

            if root.show-qr: QrDialog {
                z: 100;
                x: max(24px, (parent.width - 380px) / 2); y: max(28px, (parent.height - 435px) / 2); width: min(380px, parent.width - 48px); height: min(435px, parent.height - 56px);
                relay-qr-payload: root.relay-qr-payload;
                relay-qr-image: root.relay-qr-image;
                close => { root.action("close-qr"); }
            }
            if root.relay-pending-active: Rectangle {
                z: 101;
                width: parent.width; height: parent.height; background: #05070a99;
                TouchArea { width: 100%; height: 100%; mouse-cursor: default; }
                DialogShell {
                    x: max(24px, (parent.width - 440px) / 2); y: max(24px, (parent.height - 260px) / 2); width: min(440px, parent.width - 48px); height: 260px;
                    title: UiI18n.localized("relay.pairing_title");
                    close => { root.action("relay-enrollment-reject"); }
                    Text { x: 20px; y: 50px; width: parent.width - 40px; text: UiI18n.localized("relay.pairing_help"); color: #aebdca; font-size: 10px * UiTheme.panel-scale; wrap: word-wrap; }
                    Text { x: 20px; y: 95px; width: parent.width - 40px; text: root.relay-pending-peer-name == "" ? root.relay-pending-peer-id : root.relay-pending-peer-name + " (" + root.relay-pending-peer-addr + ")"; color: #edf3f7; font-size: 13px * UiTheme.panel-scale; wrap: word-wrap; }
                    Text { x: 20px; y: 125px; width: parent.width - 40px; text: UiI18n.formatted-one("relay.qr_pin", root.relay-host-pin); color: #57c785; font-size: 12px * UiTheme.panel-scale; }
                    ActionButton { x: parent.width - 210px; y: parent.height - 48px; width: 90px; text: UiI18n.localized("relay.enrollment_decline"); clicked => { root.action("relay-enrollment-reject"); } }
                    ActionButton { x: parent.width - 105px; y: parent.height - 48px; width: 90px; text: UiI18n.localized("relay.enrollment_accept"); clicked => { root.action("relay-enrollment-accept"); } }
                }
            }
        }

        if root.show-statusbar: Rectangle {
            x: 0px;
            y: root.height - root.status-height;
            width: root.width;
            height: root.status-height;
            background: #20262d;
            border-color: #36414c;
            border-width: 1px;
            Text {
                x: root.rail-width + 12px;
                width: root.width - root.rail-width - 220px;
                height: parent.height;
                text: root.status;
                color: #b7c5d0;
                font-size: 10px * root.ui-text-scale;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: root.width - 200px;
                width: 186px;
                height: parent.height;
                text: root.backend != "" ? root.backend + " · " + root.graph-counts : root.graph-counts;
                color: #8798a7;
                font-size: 9px * root.ui-text-scale;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
            }
        }

        ConnectionToast {
            x: root.rail-width + 18px;
            y: max(16px, root.height - 68px);
            width: min(520px, root.width - root.rail-width - 36px);
            height: 38px;
            message: root.toast-message;
            shown: root.toast-visible;
            error: root.toast-error;
        }

        // One tooltip for the whole rail. Per-button tooltips could not survive
        // the buttons moving inside `if` blocks, because Slint does not expose
        // ids declared inside a conditional. The buttons report their own hover
        // instead, which also keeps this correct while the rail is scrolled: the
        // reported position is window-space, not scrolled-content space.
        RailTooltip {
            x: root.rail-width + 8px;
            y: clamp(root.tip-anchor-y + 6px, 8px, root.height - root.status-height - 38px);
            text: root.tip-text;
            shown: root.tip-shown;
        }
    }
}

// RailButton and the hover plumbing were duplicated for every entry in MainWindow.
// Centralizing here keeps the hover-changed contract in one place.
import { AppTokens } from "../foundation/tokens.slint";
export component RailButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    // Reports hover along with the label and the button's window-space
    // position. A shared tooltip needs both because a button inside an `if`
    // cannot be reached by id from outside it.
    callback hover-changed(bool, string, length);

    height: 42px;
    background: root.active ? #245777 : touch.has-hover && root.enabled ? #2d3844 : transparent;
    border-color: key-focus.has-focus ? AppTokens.border-button-selected : transparent;
    border-width: 1px;
    border-radius: AppTokens.radius-md;
    // The rail is the app's main toolbar, so it has to be reachable by Tab
    // and activated by Enter/Space like any other button.
    forward-focus: key-focus;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        source: root.icon;
        opacity: root.enabled ? 1 : 0.42;
    }
    key-focus := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.repeat) { return accept; }
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            if (root.enabled) { root.clicked(); }
        }
    }
    changed hovered => {
        root.hover-changed(root.hovered, root.label, root.absolute-position.y);
    }
}

// DRY wrapper: every rail entry is 42px wide and forwards hover to the
// parent's rail-hover helper. Using this instead of raw RailButton removes
// the per-entry `width: 42px` repetition; the data-driven rail (see
// main.slint) owns the single `hover-changed => root.rail-hover(...)` forwarder.
export component RailActionButton inherits RailButton {
    width: 42px;
}

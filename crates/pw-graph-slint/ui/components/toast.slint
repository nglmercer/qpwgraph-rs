import { UiTheme } from "../foundation/theme.slint";
import { AppTokens } from "../foundation/tokens.slint";
import { Tooltip } from "tooltip.slint";

// Single visual implementation lives in tooltip.slint; keep rail name as alias.
export component RailTooltip inherits Tooltip { }

export component AppToast inherits Rectangle {
    in property <string> message;
    in property <bool> shown: false;
    in property <bool> error: false;

    visible: root.shown && root.message != "";
    background: root.error ? #6d3030f2 : #245777f2;
    border-color: root.error ? #c76b6b : #68a8d5;
    border-width: 1px;
    border-radius: AppTokens.radius-md;
    z: 1000;

    Text {
        x: 12px;
        y: 7px;
        width: parent.width - 24px;
        height: parent.height - 14px;
        text: root.message;
        color: #f2f6f8;
        font-size: 11px * UiTheme.ui-scale;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Compatibility name retained for older UI imports and downstream skins.
export component ConnectionToast inherits AppToast { }

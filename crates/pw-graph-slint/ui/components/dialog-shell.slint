import { UiTheme } from "../foundation/theme.slint";
import { UiI18n } from "../foundation/i18n.slint";
import { AppTokens } from "../foundation/tokens.slint";
import { IconButton } from "icon-button.slint";
import { Tooltip } from "tooltip.slint";

// Reusable centered dialog frame. History, Effects, QR, node appearance and
// the preference/shortcut dialogs all share this outer rectangle, border
// and close affordance. Feature dialogs provide only their inner content.
export component DialogShell inherits Rectangle {
    in property <string> title: "";
    in property <length> title-size: 19px * UiTheme.ui-scale;
    in property <length> title-x: 20px;
    in property <length> title-y: 18px;
    in property <bool> show-header-close: true;
    in property <length> header-close-y: 14px;
    in property <color> bg: AppTokens.dialog-bg;
    in property <color> border-col: AppTokens.border-dialog;
    callback close();

    // The close control is icon-only, so keep a visible tooltip in the shell
    // rather than relying only on its accessible label. Rendering it beside
    // the dialog also keeps it out of any child ScrollView clipping region.
    property <string> header-tooltip-text: "";
    property <bool> header-tooltip-shown: false;
    property <length> header-tooltip-anchor-x: 0px;
    property <length> header-tooltip-anchor-y: 0px;

    background: root.bg;
    border-color: root.border-col;
    border-width: 1px;
    border-radius: AppTokens.radius-xl;

    // Header – only shown when a title is supplied. Callers that need a
    // custom header (e.g. centered preferences title) leave `title` empty
    // and draw their own Text inside @children.
    if root.title != "": Text {
        x: root.title-x;
        y: root.title-y;
        width: parent.width - 80px;
        height: 24px;
        text: root.title;
        color: #f0f4f7;
        font-size: root.title-size;
        vertical-alignment: center;
        overflow: elide;
    }

    IconButton {
        visible: root.show-header-close;
        x: parent.width - 47px;
        y: root.header-close-y;
        width: 30px;
        icon: @image-url("../../../../assets/icons/close.svg");
        tooltip: UiI18n.localized("shortcuts.close");
        hover-changed(entered, tip, ax, ay) => {
            if (entered) {
                root.header-tooltip-text = tip;
                root.header-tooltip-anchor-x = ax;
                root.header-tooltip-anchor-y = ay;
                root.header-tooltip-shown = true;
            } else if (root.header-tooltip-text == tip) {
                root.header-tooltip-shown = false;
            }
        }
        clicked => { root.close(); }
    }

    // Content area – callers place their dialog body here.
    content := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        @children
    }

    Tooltip {
        x: clamp(root.header-tooltip-anchor-x - root.absolute-position.x - self.width - 8px, 8px, parent.width - self.width - 8px);
        y: clamp(root.header-tooltip-anchor-y - root.absolute-position.y, 8px, parent.height - self.height - 8px);
        text: root.header-tooltip-text;
        shown: root.header-tooltip-shown;
        z: 1000;
    }
}

// Variant that already positions a centered header like Preferences/Shortcuts.
// Kept lightweight: it is just DialogShell with a different default bg.
export component PreferencesShell inherits Rectangle {
    in property <color> bg: AppTokens.dialog-bg-alt;
    callback close();
    background: root.bg;
    border-color: #607080;
    border-width: 1px;
    border-radius: AppTokens.radius-lg;
    @children
}

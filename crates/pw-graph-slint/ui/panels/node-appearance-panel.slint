import { LineEdit } from "std-widgets.slint";
import { UiTheme } from "../foundation/theme.slint";
import { UiI18n } from "../foundation/i18n.slint";
import { ActionButton } from "../components/button.slint";
import { DialogShell } from "../components/dialog-shell.slint";
import { FormRow } from "../components/form.slint";

export component NodeAppearancePanel inherits DialogShell {
    title: UiI18n.localized("inspector.node_appearance");
    title-size: 18px * UiTheme.ui-scale;
    title-x: 18px;
    title-y: 16px;
    header-close-y: 12px;
    in-out property <string> node-editor-node-name: "";
    in-out property <string> node-editor-custom-name: "";
    in-out property <string> node-editor-color: "";
    callback action(string);
    VerticalLayout {
        x: 20px;
        y: 60px;
        width: parent.width - 40px;
        spacing: 4px;
        Text { height: 20px; text: root.node-editor-node-name; color: #aebdca; font-size: 10px * UiTheme.panel-scale; overflow: elide; }
        FormRow {
            label: UiI18n.localized("inspector.custom_name");
            LineEdit { height: 29px; text <=> root.node-editor-custom-name; placeholder-text: root.node-editor-node-name; }
        }
        FormRow {
            label: UiI18n.localized("inspector.custom_color");
            LineEdit { height: 29px; text <=> root.node-editor-color; placeholder-text: "#RRGGBB"; }
        }
    }
    ActionButton { x: 20px; y: 176px; width: 135px; text: UiI18n.localized("inspector.reset_name"); clicked => { root.action("node-appearance-reset-name"); } }
    ActionButton { x: 164px; y: 176px; width: 135px; text: UiI18n.localized("inspector.reset_color"); clicked => { root.action("node-appearance-reset-color"); } }
    ActionButton { x: 20px; y: 208px; width: 135px; text: UiI18n.localized("inspector.debug_identity"); clicked => { root.action("node-identity-debug"); } }
    ActionButton { x: parent.width - 190px; y: 236px; width: 78px; text: UiI18n.localized("shortcuts.close"); clicked => { root.action("node-appearance-close"); } }
    ActionButton { x: parent.width - 104px; y: 236px; width: 84px; text: UiI18n.localized("inspector.save"); clicked => { root.action("node-appearance-save"); } }
}

import { CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";
import { UiTheme } from "../foundation/theme.slint";
import { UiI18n } from "../foundation/i18n.slint";
import { ActionButton } from "../components/button.slint";
import { IconButton } from "../components/icon-button.slint";
import { FormRow, FormSection, TabStrip } from "../components/form.slint";
import { RelayRow } from "../foundation/structs.slint";

// The standard Material controls have generous desktop minimum widths. Relay
// has its own responsive column, so let that resolved width be authoritative
// when the application is at its supported minimum size.
component RelayLineEdit inherits LineEdit {
    min-width: 0px;
}

component RelayComboBox inherits ComboBox {
    min-width: 0px;
}

export component RelayPanel inherits Rectangle {
    in-out property <int> relay-tab: 0;
    in property <[RelayRow]> relay-rows: [];
    in-out property <string> relay-device-name: "";
    in-out property <string> relay-host-pin: "";
    in-out property <string> relay-host-port-text: "48123";
    in-out property <string> relay-client-target: "";
    in-out property <string> relay-client-pin: "";
    in-out property <bool> relay-auto-connect-trusted: true;
    in-out property <int> relay-codec-index: 0;
    in-out property <int> relay-frame-index: 0;
    in-out property <int> relay-transport-index: 0;
    in property <[string]> relay-codec-options: [];
    in property <[string]> relay-frame-options: [];
    in property <[string]> relay-transport-options: [];
    in property <[string]> relay-send-source-options: [];
    in property <[string]> relay-receive-sink-options: [];
    in-out property <int> relay-send-source-index: 0;
    in-out property <int> relay-receive-sink-index: 0;
    in property <bool> relay-available: false;
    in property <bool> relay-host-active: false;
    in property <string> relay-host-endpoint: "";
    in property <bool> relay-is-connecting: false;
    in property <bool> relay-direction-switching: false;
    in property <string> relay-qr-payload: "";
    callback action(string);
    callback close();

    background: #20262d;
    border-color: #506171;
    border-width: 1px;

    // The panel floats over the graph, so it has to swallow the clicks, drags
    // and wheel events that would otherwise pan or deselect the canvas below.
    // Declared first, it stays underneath every control in the panel.
    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: default;
        scroll-event(event) => { accept }
    }

    Text {
        x: 18px; y: 14px; width: parent.width - 76px; height: 28px;
        text: UiI18n.localized("relay.title");
        color: #f0f4f7;
        font-size: 18px * UiTheme.ui-scale;
        vertical-alignment: center;
        overflow: elide;
    }
    ActionButton { x: parent.width - 47px; y: 12px; width: 30px; text: "×"; clicked => { root.close(); } }
    Rectangle { x: 16px; y: 49px; width: parent.width - 32px; height: 1px; background: #3d4a56; }
    TabStrip {
        x: 16px; y: 62px; width: parent.width - 32px;
        first: UiI18n.localized("relay.mode_emitter");
        second: UiI18n.localized("relay.mode_receiver");
        third: UiI18n.localized("relay.tab_advanced");
        current-index <=> root.relay-tab;
    }

    body := ScrollView {
        x: 16px; y: 106px; width: parent.width - 32px; height: parent.height - 122px;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, body-layout.min-height);

        body-layout := VerticalLayout {
            width: body.visible-width;
            padding: 0px;
            padding-bottom: 12px;
            spacing: 9px;
            alignment: start;

            if root.relay-direction-switching: Text {
                min-height: 24px;
                text: UiI18n.localized("relay.mode_switching");
                color: #e0b062;
                font-size: 10px * UiTheme.panel-scale;
                wrap: word-wrap;
            }

            if root.relay-tab == 0: FormSection {
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: UiI18n.localized("relay.mode_emitter");
                        color: #aebdca;
                        font-size: 10px * UiTheme.panel-scale;
                        wrap: word-wrap;
                    }
                    FormRow {
                        label: UiI18n.localized("relay.send_source");
                        RelayComboBox {
                            height: 31px;
                            model: root.relay-send-source-options;
                            current-index <=> root.relay-send-source-index;
                        }
                    }
                    RelayLineEdit { height: 31px; placeholder-text: UiI18n.localized("relay.target"); text <=> root.relay-client-target; }
                    HorizontalLayout {
                        height: 31px; spacing: 8px;
                        RelayLineEdit { horizontal-stretch: 1; placeholder-text: UiI18n.localized("relay.pin"); text <=> root.relay-client-pin; }
                        ActionButton { width: 92px; text: root.relay-is-connecting ? UiI18n.localized("relay.cancel_connect") : UiI18n.localized("relay.connect"); enabled: root.relay-available && (!root.relay-direction-switching || root.relay-is-connecting); clicked => { if (root.relay-is-connecting) { root.action("relay-cancel-connect"); } else { root.action("relay-connect-configured"); } } }
                    }
                }
            }

            if root.relay-tab == 0: Text {
                height: 22px;
                text: UiI18n.localized("relay.group_available");
                color: #aebdca;
                font-size: 11px * UiTheme.panel-scale;
                vertical-alignment: center;
            }

            // This list is the desktop's discovery: without a word here an
            // empty section reads as a broken panel rather than as a search
            // still running.
            if root.relay-tab == 0 && root.relay-rows.length == 0: Text {
                min-height: 40px;
                text: UiI18n.localized("relay.no_peers");
                color: #8393a0;
                font-size: 9px * UiTheme.panel-scale;
                wrap: word-wrap;
            }

            if root.relay-tab == 0: VerticalLayout {
                spacing: 7px;
                for row in root.relay-rows: Rectangle {
                    // Two text lines plus a meter lane, with the actions in a
                    // fixed right-hand column so the name and address elide
                    // instead of pushing the buttons off the card.
                    property <length> action-width: row.peer-id != "" ? 200px : 104px;
                    property <length> text-width: max(48px, self.width - 34px - self.action-width);

                    height: 60px;
                    background: #29323c;
                    border-color: #40505f;
                    border-width: 1px;
                    border-radius: 5px;

                    // Status at a glance: green connected, amber negotiating,
                    // blue reachable, grey merely configured.
                    Rectangle {
                        x: 12px;
                        y: 15px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: row.connected ? #57c785
                            : row.connecting ? #e0b062
                            : row.state == "" ? #6b7785 : #5a9ad6;
                    }

                    Text {
                        x: 28px;
                        y: 8px;
                        width: parent.text-width;
                        height: 20px;
                        text: row.name;
                        color: #edf3f7;
                        font-size: 12px * UiTheme.panel-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        x: 28px;
                        y: 28px;
                        width: parent.text-width;
                        height: 16px;
                        text: row.state + " · " + row.address;
                        color: #9fb0be;
                        font-size: 9px * UiTheme.panel-scale;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // A track under the fill, so a silent session reads as an
                    // empty meter rather than as a stray dash.
                    if row.connected: Rectangle {
                        x: 28px;
                        y: 47px;
                        width: parent.text-width;
                        height: 4px;
                        background: #1b2129;
                        border-radius: 2px;
                        Rectangle {
                            x: 0px;
                            width: parent.width * row.level;
                            height: parent.height;
                            background: row.level > 0.9 ? #d8734f : #57c785;
                            border-radius: 2px;
                        }
                    }

                    ActionButton {
                        x: parent.width - 104px - 12px;
                        y: 15px;
                        width: 104px;
                        height: 30px;
                        text: row.connected ? UiI18n.localized("relay.disconnect")
                            : row.connecting ? UiI18n.localized("relay.cancel_connect")
                            : UiI18n.localized("relay.connect");
                        enabled: row.id != "" && (row.connected || row.connecting || (root.relay-available && !root.relay-direction-switching));
                        clicked => {
                            if (row.connected) { root.action("relay-disconnect:" + row.id); }
                            else if (row.connecting) { root.action("relay-cancel-connect"); }
                            else { root.action("relay-connect:" + row.id); }
                        }
                    }
                    if row.peer-id != "": ActionButton {
                        x: parent.width - 200px - 12px;
                        y: 15px;
                        width: 88px;
                        height: 30px;
                        text: UiI18n.localized("relay.forget");
                        enabled: true;
                        clicked => { root.action("relay-forget:" + row.peer-id); }
                    }
                }
            }

            if root.relay-tab == 1: FormSection {
                title: UiI18n.localized("relay.title");
                summary: UiI18n.localized("relay.receiver_mode_hint");

                Text {
                    min-height: 22px;
                        text: UiI18n.localized("relay.mode_receiver");
                    color: #aebdca;
                    font-size: 10px * UiTheme.panel-scale;
                    wrap: word-wrap;
                }

                FormRow {
                    label: UiI18n.localized("relay.receive_sink");
                    RelayComboBox {
                        height: 31px;
                        model: root.relay-receive-sink-options;
                        current-index <=> root.relay-receive-sink-index;
                    }
                }
                if root.relay-receive-sink-options.length == 0: Text {
                    min-height: 28px;
                    text: UiI18n.localized("relay.local_route_unavailable");
                    color: #8393a0;
                    font-size: 8px * UiTheme.panel-scale;
                    wrap: word-wrap;
                }
                FormRow { label: UiI18n.localized("relay.device_name"); RelayLineEdit { height: 31px; text <=> root.relay-device-name; } }
                FormRow {
                    label: UiI18n.localized("relay.pin");
                    HorizontalLayout {
                        spacing: 6px;
                        RelayLineEdit { horizontal-stretch: 1; height: 31px; text <=> root.relay-host-pin; }
                        IconButton {
                            width: 31px; height: 31px;
                            icon: @image-url("../../../../assets/icons/refresh.svg");
                            tooltip: UiI18n.localized("relay.pin_regenerate");
                            clicked => { root.action("relay-regenerate-pin"); }
                        }
                    }
                }
                FormRow { label: UiI18n.localized("relay.port"); RelayLineEdit { height: 31px; placeholder-text: UiI18n.localized("relay.port_help"); text <=> root.relay-host-port-text; } }
                HorizontalLayout {
                    height: 31px; spacing: 8px;
                    ActionButton { horizontal-stretch: 1; text: root.relay-host-active ? UiI18n.localized("relay.stop_host") : UiI18n.localized("relay.start_host"); enabled: root.relay-available && !root.relay-direction-switching; clicked => { root.action("relay-host-toggle"); } }
                    ActionButton { horizontal-stretch: 1; text: UiI18n.localized("relay.show_qr"); enabled: root.relay-host-active && root.relay-qr-payload != "" && !root.relay-direction-switching; clicked => { root.action("relay-show-qr"); } }
                }
                Text {
                    min-height: 28px;
                    text: root.relay-host-active ? UiI18n.formatted-one("relay.listening", root.relay-host-endpoint) : UiI18n.localized("relay.host_stopped");
                    color: root.relay-host-active ? #57c785 : #aebdca;
                    font-size: 10px * UiTheme.panel-scale;
                    wrap: word-wrap;
                }
                Text {
                    min-height: 32px;
                    text: root.relay-host-active ? UiI18n.formatted-one("relay.qr_pin", root.relay-host-pin) : UiI18n.localized("relay.advanced_help");
                    color: #aebdca;
                    font-size: 10px * UiTheme.panel-scale;
                    wrap: word-wrap;
                }
            }

            if root.relay-tab == 2: FormSection {
                title: UiI18n.localized("relay.advanced");
                FormRow { label: UiI18n.localized("relay.codec"); RelayComboBox { height: 31px; model: root.relay-codec-options; current-index <=> root.relay-codec-index; } }
                FormRow { label: UiI18n.localized("relay.frame_ms"); RelayComboBox { height: 31px; model: root.relay-frame-options; current-index <=> root.relay-frame-index; } }
                FormRow { label: UiI18n.localized("relay.transport"); RelayComboBox { height: 31px; model: root.relay-transport-options; current-index <=> root.relay-transport-index; } }
                CheckBox { height: 31px; text: UiI18n.localized("relay.auto_connect_trusted"); checked <=> root.relay-auto-connect-trusted; }
                Text {
                    min-height: 44px;
                    text: UiI18n.localized("relay.auto_connect_trusted_help");
                    color: #aebdca;
                    font-size: 10px * UiTheme.panel-scale;
                    wrap: word-wrap;
                }
                Text {
                    min-height: 44px;
                    text: UiI18n.localized("relay.advanced_help");
                    color: #aebdca;
                    font-size: 10px * UiTheme.panel-scale;
                    wrap: word-wrap;
                }
            }
        }
    }
}
